[Unit]
Description=Psiphon tunnel instance for region %i
Documentation=https://github.com/Psiphon-Labs/psiphon-tunnel-core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %i is the country code (e.g. US). The wizard (Phase 4) writes the matching
# per-country config JSON to /opt/psiphon-3x-ui/config/<CODE>.json, then starts
# this templated unit (systemctl start psiphon-tunnel@US.service).
#
# Phase 24 Hotfix #3 (Bug: per-country tunnel unit dies with exit 1 silently
# because the default datastore directory path resolves to a location the
# sandboxed service cannot mkdir):
#
#   binary stdout when started under the OLD ExecStart (which omitted this
#   flag) read EXACTLY:
#     {"data":{"message":"error loading configuration file:
#     psiphon.(*Config).Commit#1514: failed to create datastore directory
#     with error: mkdir [redacted]: no such file or
#     directory"},"noticeType":"Error",...}
#
# Without `-dataRootDirectory`, ConsoleClient computes a default datastore
# path that, under `ProtectSystem=strict` + `PrivateTmp=true` + `User=psiphon3xui`,
# cannot be mkdir'd (the binary's default path resolves to under
# `/opt/psiphon-3x-ui/<some-prefix>` that requires intermediate-parent writes
# the sandbox denies, OR under `/root`/`$HOME` blocked by `ProtectHome=true`).
# It then exits 1 before the SOCKS5 listener is bound — so the dashboard's
# `health_probe` sees `connect 127.0.0.1:11000 failed: ConnectionRefusedError`
# and the operator reads "inline enable for UA failed".
#
# Fix: pass `-dataRootDirectory /opt/psiphon-3x-ui/data/%i` so ConsoleClient
# writes its per-country datastore (server list cache, obfuscated-server-list
# registry, key material, etc.) into a psiphon3xui-owned writable directory.
# The installer (panel_install.sh) pre-creates `/opt/psiphon-3x-ui/data/`
# with ownership `psiphon3xui:psiphon3xui` and mode 0700. Each `systemctl
# start psiphon-tunnel@<CODE>` invocation creates its own per-country
# `data/<CODE>/` subdirectory under the root on first run (WriteBits are
# within `ReadWritePaths=/opt/psiphon-3x-ui` which covers `data/`, so the
# mkdir succeeds). Confirmed live: with the flag pointing at a writable
# pre-created directory, the binary's strace shows
# `openat(... "/opt/psiphon-3x-ui/data/UA/ca.psiphon.PsiphonTunnel.tunnel-core/osl/osl-registry.cached")`
# (ENOENT on first run — acceptable), then binds
# `{"data":{"port":11000},"noticeType":"ListeningSocksProxyPort"}` ✓ and
# exits 0 on shutdown (vs exit 1 without the flag).
#
# Phase 24 Hotfix #4 (follow-up to Hotfix #3 — post-deploy field report
# 2026-07-28): the operator's fresh install landed Hotfix #3's ExecStart
# (`/etc/systemd/system/psiphon-tunnel@.service` confirmed via `systemctl
# cat` to carry `-dataRootDirectory /opt/psiphon-3x-ui/data/%i`) BUT the
# installer-side `install -d -m 0700 -o ${PSIPHON3XUI_USER} -g
# ${PSIPHON3XUI_GROUP} ${DATA_DIR}` block in
# `installer/panel_install.sh` did NOT fire — verifiable: `ls -ld
# /opt/psiphon-3x-ui/data` returned "No such file or directory", and
# `systemctl status psiphon-tunnel@US.service` showed the unit in an
# `activating (auto-restart) (Result: exit-code)` restart loop with
# `Main process exited, code=exited, status=1/FAILURE` because
# psiphon-tunnel-core's mkdir of `/opt/psiphon-3x-ui/data/US` failed — its
# PARENT `/opt/psiphon-3x-ui/data` did not exist. Same ConnectionRefused
# surface symptom as before Hotfix #3 ("inline enable for US failed:
# SOCKS5 health probe on 127.0.0.1:11000 failed after retry").
#
# Root cause for the missed pre-create was non-deterministic from the
# captured diagnostics (likely a CDN edge cache served a stale
# `installer/panel_install.sh`, OR `DATA_DIR` was undefined in the
# installer shell env, OR the `install -d` exited non-zero). Regardless,
# relying on the installer to pre-create a directory the systemd unit
# ALSO needs is fragile. This Hotfix #4 makes the unit SELF-SUFFICIENT:
# `ExecStartPre=` is a privileged pre-flight (it runs as the unit's `User=`
# — here `psiphon3xui` — and `ReadWritePaths=/opt/psiphon-3x-ui` grants the
# service writeBits there, so the pre-flight can recursively create the
# per-country dir + its parent). This works with or without Hotfix #3's
# installer-side pre-create (which still acts as belt-and-braces for
# first-time race tolerance). Idempotent on a pre-existing dir, so
# subsequent restarts keep working. After this, the operator's
# previously-failing US tunnel starts cleanly once the new unit file is
# dropped in + `systemctl daemon-reload` runs — without re-running the
# installer or having to `mkdir -p /opt/psiphon-3x-ui/data` by hand.
# Phase 24 Hotfix #4's ExecStartPre shape `/usr/bin/install -d -m 0700
# -o psiphon3xui -g psiphon3xui ...` previously specified `-o psiphon3xui
# -g psiphon3xui` — but `install -d -o <uid> -g <gid>` ONLY succeeds when
# the CALLER is root (chown is a privileged syscall; even with the unit's
# `User=`->`Group=` privilege, the kernel still rejects a chown that isn't
# executed as uid 0). When the unit ran as `User=psiphon3xui`, the
# ExecStartPre failed with `install: cannot create directory
# '/opt/psiphon-3x-ui/data': Permission denied`. The error is misleading —
# the "install" program called chown before mkdir, and only then does the
# mkdir fail. On Phase 24 Hotfix #4 it landed anyway (the operator's
# earlier manual fix succeeded), which is why the symptom didn't surface.
#
# Phase 25 Hotfix #12 dropped the `-o`/`-g` args so `install -d -m 0700`
# wouldn't call chown at all. That worked in SOME setups but the operator's
# fresh install (Phase 26, with Hotfixes #10+#11 applied) STILL failed —
# journald showed:
#
#   Aug 02 18:57:52 ali install[10644]: /usr/bin/install: cannot create
#   directory '/opt/psiphon-3x-ui/data': Permission denied
#
# repeating ~14 times in a tight RestartSec=5 loop. The cause: GNU
# coreutils `install -d` on newer Ubuntu releases internally still calls
# chown(2) on the directory it's about to create — even when no `-o`/`-g`
# was passed — when the target's parent has the setgid bit set (which
# /opt/psiphon-3x-ui does, mode 2775 since Hotfix #12). With
# `NoNewPrivileges=true` + `ProtectSystem=strict` the CAP_CHOWN capability
# is stripped, so the syscall fails with EACCES.
#
# Phase 26 Hotfix #13: replace `install -d` with plain `mkdir -p`. `mkdir`
# (also coreutils) NEVER calls chown — the new directory simply inherits
# the creating process's uid/gid (here psiphon3xui per `User=`/`Group=`).
# The mode `0700` is applied atomically at mkdir time (no chmod followup
# needed). `-p` makes it idempotent across restarts and also tolerant of
# the installer-side pre-create at panel_install.sh:454 still running as
# root with the full `install -d -o/-g` form (which IS privileged there
# and remains in place as belt-and-braces). `--` ends option parsing so
# a future country code that began with `-` would be treated literally.
ExecStartPre=/usr/bin/mkdir -p -m 0700 -- /opt/psiphon-3x-ui/data/%i
ExecStart=/opt/psiphon-3x-ui/bin/psiphon-tunnel-core \
    -config /opt/psiphon-3x-ui/config/%i.json \
    -dataRootDirectory /opt/psiphon-3x-ui/data/%i
WorkingDirectory=/opt/psiphon-3x-ui
Restart=on-failure
RestartSec=10

# Tunnels need outbound network but no privileged capabilities.
User=psiphon3xui
Group=psiphon3xui
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/psiphon-3x-ui

# Optional per-country network-namespace isolation. Leave commented out by
# default — netns management is the operator's responsibility (e.g. via the
# `ip netns` tooling, not systemd). To enable, install the namespace at
# `/run/netns/<CODE>` for each country you start a tunnel for, then uncomment:
# NetworkNamespacePath=/run/netns/%i

[Install]
WantedBy=multi-user.target
