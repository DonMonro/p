# ============================================================================
# 49-psiphon-3x-ui.sudoers — installed to /etc/sudoers.d/49-psiphon-3x-ui
# ----------------------------------------------------------------------------
# Phase 28 (item 1, part 3). The panel service runs as the unprivileged
# `psiphon3xui` user. When the operator changes the panel port from Settings,
# the panel must open the new port in ufw BEFORE it rewrites panel.env and
# restarts itself — otherwise it comes back on a port ufw is still filtering
# while the old port is already gone, i.e. a total lockout.
#
# ufw is root-only and is not a systemd unit, so the polkit rule in
# 49-psiphon-3x-ui.rules (which grants only org.freedesktop.systemd1.
# manage-units) cannot authorise it. This drop-in is the narrowest grant that
# makes the port change work.
#
# Scope, deliberately minimal:
#   * exactly one user (the service user, patched by panel_install.sh if the
#     operator renamed it)
#   * exactly one verb — `ufw allow` (no delete, no enable/disable, no reset,
#     no default policy, no `ufw` with arbitrary arguments)
#   * argument is a literal 1-to-5-digit TCP port and nothing else
#
# The digit classes are enumerated rather than written `[0-9]*/tcp` on purpose.
# sudo matches command arguments as ONE concatenated string, so a `*` there
# also matches spaces — `[0-9]*/tcp` would permit multi-word rule specs like
# `1 to any port 3306/tcp`. `[0-9]` classes cannot match anything but a single
# digit, so the grant is exactly "add an allow rule for a numeric TCP port".
#
# installer/firewall.sh additionally validates PANEL_PORT is a 1-65535 integer
# before it ever reaches this command line.
#
# Note this is NOT sudo on firewall.sh itself: that script lives under the
# install prefix, so granting root on it would hand root to anyone who can
# write there. Granting `ufw allow` directly keeps the blast radius to adding
# an accept rule.
# ============================================================================

# ufw is a Debian/Ubuntu tool and ships at /usr/sbin/ufw; /sbin/ufw is the
# pre-usrmerge path and /usr/bin/ufw appears on a few derivatives. sudo matches
# the resolved absolute path, so every plausible location must be listed or the
# grant silently does not apply.
Cmnd_Alias PSIPHON3XUI_UFW_ALLOW = \
    /usr/sbin/ufw allow [0-9]/tcp,                     \
    /usr/sbin/ufw allow [0-9][0-9]/tcp,                \
    /usr/sbin/ufw allow [0-9][0-9][0-9]/tcp,           \
    /usr/sbin/ufw allow [0-9][0-9][0-9][0-9]/tcp,      \
    /usr/sbin/ufw allow [0-9][0-9][0-9][0-9][0-9]/tcp, \
    /sbin/ufw allow [0-9]/tcp,                         \
    /sbin/ufw allow [0-9][0-9]/tcp,                    \
    /sbin/ufw allow [0-9][0-9][0-9]/tcp,               \
    /sbin/ufw allow [0-9][0-9][0-9][0-9]/tcp,          \
    /sbin/ufw allow [0-9][0-9][0-9][0-9][0-9]/tcp,     \
    /usr/bin/ufw allow [0-9]/tcp,                      \
    /usr/bin/ufw allow [0-9][0-9]/tcp,                 \
    /usr/bin/ufw allow [0-9][0-9][0-9]/tcp,            \
    /usr/bin/ufw allow [0-9][0-9][0-9][0-9]/tcp,       \
    /usr/bin/ufw allow [0-9][0-9][0-9][0-9][0-9]/tcp

# The panel invokes this from a systemd service, never from a login shell, so
# a controlling TTY is never present. Distros that still ship requiretty=on
# (older RHEL derivatives) would otherwise reject it outright.
Defaults!PSIPHON3XUI_UFW_ALLOW !requiretty

psiphon3xui ALL=(root) NOPASSWD: PSIPHON3XUI_UFW_ALLOW
