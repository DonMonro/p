[Unit]
Description=Watch /opt/psiphon-3x-ui/xray-patch-queue for per-country Xray outbound+routing patch files
Documentation=man:systemd.path(5)
# Phase 25 Hotfix #10: this path unit triggers psiphon-xray-applier.service
# every time a panel-side _enqueue_xray_patch() call drops a patch file into
# the queue directory. The .service runs as root and is the ONLY component
# allowed to read/write /usr/local/x-ui/bin/config.json (the panel process
# runs as the unprivileged psiphon3xui user, which cannot read the
# root-only-owned live config — see docs/ARCHITECTURE.md "Xray applier
# sidecar" section).
# Requires= is deliberately omitted: if the directory is empty on boot the
# service fires once via `WantedBy=multi-user.target`'s implicit start but
# is a no-op (the applier script exits 0 on an empty queue).

[Path]
# Fire when a patch file is created (the panel uses write-tmp+rename, so
# `PathChanged` on the directory edge-triggers on the rename event, not
# on the intermediate tmp file).
PathChanged=/opt/psiphon-3x-ui/xray-patch-queue
# Ensure the queue directory exists at boot with the right ownership
# (root:psiphon3xui, mode 0755) so the panel user can mktemp+rename files
# inside it but no other unprivileged user can.
DirectoryMode=0755
# Batch bursts of panel edits into a single applier run (70 ms debounce) so
# a Feature-C enable or wizard batch clone that touches multiple countries
# restarts x-ui.service ONLY once at the end.
TriggerLimitIntervalSec=70ms

[Install]
WantedBy=multi-user.target
